@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies

<!DOCTYPE html>
<html lang="vi">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Quản Lý Khách Sạn</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

</head>

<body>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {

        <div class="d-flex flex-column flex-lg-row">

            <div class="sidebar-panel">

                <h2 class="text-center mb-4 fw-bold">
                    HOTEL
                </h2>

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-speedometer2 me-2"></i>Quản lý khách sạn
                </a>

                <a asp-controller="Room"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-door-open me-2"></i>Quản lý phòng
                </a>

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-people me-2"></i>Khách hàng
                </a>

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-calendar-check me-2"></i>Đặt phòng
                </a>

                <a asp-controller="Invoice"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-receipt me-2"></i>Hóa đơn
                </a>

                <a asp-controller="Service"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-stars me-2"></i>Dịch vụ
                </a>

                <a asp-controller="Contact"
                   asp-action="List"
                   class="sidebar-link">
                    <i class="bi bi-envelope me-2"></i>Liên hệ khách hàng
                </a>

                <a asp-controller="Login"
                   asp-action="Logout"
                   class="sidebar-link-danger">
                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                </a>

            </div>

            <div class="flex-grow-1 p-4">

                @RenderBody()

            </div>

        </div>

    }
    else
    {

        <nav class="navbar navbar-dark custom-navbar sticky-top">

            <div class="container">

                <div class="navbar-row w-100">

                    <button class="nav-burger-btn"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mainNavbar"
                            aria-label="Menu">
                        <i class="bi bi-list"></i>
                    </button>

                    <a class="navbar-brand d-flex align-items-center"
                       asp-controller="Home"
                       asp-action="Index">

                        <img src="~/images/logo.jpg"
                             alt="Logo"
                             style="width:45px;
                        height:45px;
                        object-fit:cover;
                        border-radius:50%;
                        margin-right:10px;">

                        <span>Quản Lý Khách Sạn</span>

                    </a>

                    <div class="navbar-actions">

                        <button id="themeToggle"
                                class="theme-toggle-btn">
                            🌙
                        </button>

                    </div>

                </div>

            </div>

            <div class="collapse" id="mainNavbar">

                <div class="nav-dropdown-panel">

                    <div class="container py-3">

                        <ul class="list-unstyled d-flex flex-column flex-md-row flex-wrap gap-2 mb-0 justify-content-center align-items-center">

                            <li class="nav-item">
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="nav-link nav-link-custom">
                                    Trang chủ
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Home"
                                   asp-action="Rooms"
                                   class="nav-link nav-link-custom">
                                    Danh sách phòng
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Home"
                                   asp-action="Services"
                                   class="nav-link nav-link-custom">
                                    Dịch vụ
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Contact"
                                   asp-action="Index"
                                   class="nav-link nav-link-custom">
                                    Liên hệ
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Login"
                                   asp-action="Index"
                                   class="nav-link nav-link-custom">
                                    Đăng nhập
                                </a>
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </nav>

        <div class="container mt-4">

            @RenderBody()

        </div>

    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", false)

</body>
</html>