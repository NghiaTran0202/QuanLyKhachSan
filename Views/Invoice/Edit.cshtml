@model quanlykhachsan.Models.Invoice

@{
    ViewData["Title"] = "Sửa hóa đơn";
}

<h2 class="mb-3">SỬA HÓA ĐƠN</h2>

<form asp-action="Edit" method="post">

    <input asp-for="InvoiceId" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Mã đặt phòng</label>
        <select asp-for="BookingId"
                asp-items="ViewBag.BookingId"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="InvoiceDate" class="form-label"></label>
        <input asp-for="InvoiceDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tiền phòng</label>
        <input asp-for="RoomAmount" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tiền dịch vụ</label>
        <input asp-for="ServiceAmount" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Tổng tiền</label>
        <input asp-for="TotalAmount" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Cập nhật
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}