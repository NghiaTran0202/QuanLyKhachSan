@model quanlykhachsan.Models.Invoice

@{
    ViewData["Title"] = "Thêm hóa đơn";
}

<h2 class="mb-3">THÊM HÓA ĐƠN</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Mã đặt phòng</label>
        <select asp-for="BookingId"
                asp-items="ViewBag.BookingId"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="InvoiceDate" class="form-label"></label>
        <input asp-for="InvoiceDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="RoomAmount" class="form-label">Tiền phòng</label>
        <input asp-for="RoomAmount" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ServiceAmount" class="form-label">Tiền dịch vụ</label>
        <input asp-for="ServiceAmount" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="TotalAmount" class="form-label">Tổng tiền</label>
        <input asp-for="TotalAmount" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Lưu
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại
    </a>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}