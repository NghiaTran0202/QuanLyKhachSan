@model IEnumerable<quanlykhachsan.Models.Room>

@{
    ViewData["Title"] = "Quản lý phòng";
}

<div class="container-fluid mt-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>QUẢN LÝ PHÒNG</h2>

        <a asp-action="Create" class="btn btn-success">
            + Thêm phòng
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <form method="get" class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Nhập số phòng, tên phòng hoặc loại phòng..." />

            <button class="btn btn-primary"
                    type="submit">
                Tìm kiếm
            </button>

        </div>

    </form>

    <div class="table-responsive">

        <table class="table table-bordered table-hover table-striped text-nowrap">

            <thead class="table-dark">

                <tr>
                    <th>Mã</th>
                    <th>Số phòng</th>
                    <th>Tên phòng</th>
                    <th>Loại phòng</th>
                    <th>Giá theo ngày</th>
                    <th>Giá giờ đầu</th>
                    <th>Trạng thái</th>
                    <th>Ảnh</th>
                    <th>Chức năng</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.RoomId</td>

                        <td>@item.RoomNumber</td>

                        <td>@item.RoomName</td>

                        <td>@item.RoomType?.TypeName</td>

                        <td>
                            @item.Price.ToString("N0") VNĐ
                        </td>

                        <td>
                            @if (item.HourlyPrice > 0)
                            {
                                @($"{item.HourlyPrice:N0} VNĐ")
                            }
                            else
                            {
                                <span class="text-danger">
                                    Chưa thiết lập
                                </span>
                            }
                        </td>

                        <td>
                            @if (item.Status)
                            {
                                <span class="badge bg-danger">
                                    Đã sử dụng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Còn trống
                                </span>
                            }
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="~/uploads/@item.Image"
                                     width="80"
                                     height="60"
                                     class="rounded"
                                     style="object-fit: cover;" />
                            }
                            else
                            {
                                <span class="text-danger">
                                    Chưa có ảnh
                                </span>
                            }
                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.RoomId"
                               class="btn btn-info btn-sm">
                                Chi tiết
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.RoomId"
                               class="btn btn-warning btn-sm">
                                Sửa
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.RoomId"
                               class="btn btn-danger btn-sm">
                                Xóa
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>